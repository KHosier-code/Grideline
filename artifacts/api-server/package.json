{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "worker": "node --enable-source-maps ./dist/worker.mjs",
    "personnel-comparison": "export NODE_ENV=development && node --enable-source-maps ./dist/personnel-comparison-cli.mjs",
    "test:personnel-comparison": "pnpm run build && node --test ./dist/lib/personnel-comparison.test.mjs",
    "sportsdataio-depth-evaluation": "export NODE_ENV=development && pnpm run build && node --enable-source-maps ./dist/sportsdataio-depth-cli.mjs",
    "test:sportsdataio-depth": "pnpm run build && node --test ./dist/lib/sportsdataio-depth.test.mjs",
    "test:production-database-smoke": "pnpm run build && node --test ./dist/lib/production-database-smoke.test.mjs ./dist/lib/production-startup-alert.test.mjs",
    "test:current-personnel": "pnpm run build && node --test ./dist/lib/current-personnel-derivation.test.mjs ./dist/lib/current-personnel.test.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@clerk/express": "^2.1.67",
    "@clerk/shared": "^4.31.1",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "catalog:",
    "express": "^5.2.1",
    "http-proxy-middleware": "^4.2.0",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "esbuild": "0.28.2",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.1.3",
    "thread-stream": "3.1.0"
  }
}
